<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Official HOPPOLLY artist website. Music, videos, latest releases and updates.">
  <title>HOPPOLLY | Official Artist Website</title>
  <style>
  * { 
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    background: #080808;
    color: white;
    line-height: 1.6;
}


/* ================= NAVBAR ================= */

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 6%;

    background: rgba(0, 0, 0, 0.75);

    backdrop-filter: blur(15px);

    z-index: 1000;
}

.logo {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 3px;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;

    transition: 0.3s;
}

nav a:hover {
    opacity: 0.6;
}


/* ================= HERO ================= */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;

    overflow: hidden;

    padding: 120px 7% 70px;

    background:
        radial-gradient(
            circle at 70% 40%,
            #302000,
            #080808 60%
        );
}

.hero-image {
    width: 48%;
    max-width: 600px;
}

.hero-image img {
    width: 100%;
    display: block;

    border-radius: 20px;

    box-shadow:
        0 30px 80px rgba(0,0,0,0.7);
}

.hero-content {
    width: 45%;
    padding-left: 60px;
}

.small-title {
    font-size: 13px;
    letter-spacing: 4px;
    opacity: 0.7;
}

.hero h1 {
    font-size: clamp(60px, 10vw, 140px);

    line-height: 0.95;

    margin: 20px 0;

    font-weight: 900;

    letter-spacing: -5px;
}

.hero-text {
    font-size: 20px;
    opacity: 0.8;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 35px;
}

.btn,
.big-button,
.music-button {
    display: inline-block;

    padding: 14px 24px;

    background: white;
    color: black;

    text-decoration: none;

    border-radius: 50px;

    font-weight: 800;

    transition: 0.3s;
}

.btn:hover,
.big-button:hover,
.music-button:hover {
    transform: translateY(-4px);
}

.btn-outline {
    background: transparent;
    color: white;
    border: 1px solid white;
}


/* ================= SECTIONS ================= */

.section {
    padding: 110px 7%;
}

.section-title {
    text-align: center;
    margin-bottom: 60px;
}

.section-title p {
    font-size: 12px;
    letter-spacing: 4px;
    opacity: 0.5;
}

.section-title h2 {
    font-size: clamp(35px, 5vw, 65px);
    margin-top: 10px;
}


/* ================= ABOUT ================= */

.about-box {
    max-width: 800px;
    margin: auto;

    text-align: center;

    font-size: 19px;

    opacity: 0.8;
}

.about-box p {
    margin-bottom: 20px;
}


/* ================= MUSIC ================= */

.music-section {
    background: #101010;
}

.music-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 25px;
}

.music-card {
    background: #181818;

    border-radius: 18px;

    overflow: hidden;

    transition: 0.3s;
}

.music-card:hover {
    transform: translateY(-8px);
}

.music-card img {
    width: 100%;
    aspect-ratio: 1/1;

    object-fit: cover;
}

.music-info {
    padding: 20px;
}

.music-info h3 {
    font-size: 19px;
}

.music-info p {
    font-size: 13px;
    opacity: 0.6;
    margin: 5px 0 20px;
}

.music-button {
    padding: 10px 18px;
    font-size: 12px;
}


/* ================= BUTTON ================= */

.center-button {
    text-align: center;
    margin-top: 50px;
}

.big-button {
    padding: 16px 30px;
}


/* ================= VIDEO ================= */

.video-box {
    max-width: 900px;

    margin: auto;

    aspect-ratio: 16 / 9;

    border-radius: 20px;

    overflow: hidden;

    background: #151515;
}

.video-box iframe {
    width: 100%;
    height: 100%;

    border: 0;
}


/* ================= SOCIALS ================= */

.social-grid {
    max-width: 800px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 15px;
}

.social-card {
    display: block;

    padding: 25px;

    text-align: center;

    background: #151515;

    border: 1px solid #292929;

    border-radius: 15px;

    color: white;

    text-decoration: none;

    font-weight: 700;

    transition: 0.3s;
}

.social-card:hover {
    background: white;
    color: black;
}


/* ================= FOOTER ================= */

footer {
    text-align: center;

    padding: 70px 20px;

    background: #050505;
}

footer h2 {
    font-size: 30px;
    letter-spacing: 4px;
}

footer p {
    opacity: 0.6;
}

.copyright {
    margin-top: 30px;
    font-size: 12px;
}


/* ================= MOBILE ================= */

@media (max-width: 900px) {

    .navbar {
        padding: 17px 5%;
    }

    nav {
        display: none;
    }

    .hero {
        flex-direction: column;

        padding-top: 120px;

        text-align: center;
    }

    .hero-image {
        width: 100%;
        max-width: 500px;
    }

    .hero-content {
        width: 100%;
        padding: 40px 0 0;
    }

    .hero h1 {
        font-size: 70px;
    }

    .hero-buttons {
        justify-content: center;

        flex-wrap: wrap;
    }

    .music-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }
}


@media (max-width: 550px) {

    .section {
        padding: 80px 5%;
    }

    .music-grid {
        grid-template-columns: 1fr;
    }

    .social-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 60px;
    }

  }
